<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Monolith.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monolith.Core\Monolith.Core.csproj" />
    <ProjectReference Include="..\Monolith.Voice\Monolith.Voice.csproj" />
    <ProjectReference Include="..\Monolith.WebSocket\Monolith.WebSocket.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <WebRtcVadFiles Include="$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\*\WebRtcVad.dll" />
  </ItemGroup>
  <Target Name="CopyWebRtcVad" AfterTargets="AfterBuild" Condition="Exists('$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build')">
    <Copy SourceFiles="$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\x64\WebRtcVad.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\x64\WebRtcVad.dll')" />
    <Copy SourceFiles="$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\x86\WebRtcVad.dll" DestinationFolder="$(OutputPath)" Condition="!Exists('$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\x64\WebRtcVad.dll') and Exists('$(NuGetPackageRoot)webrtcvadsharp\1.3.0\build\x86\WebRtcVad.dll')" />
  </Target>

  <Target Name="CopyEspeakNg" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\runtimes\win-x64\native\espeak-ng.exe"
          DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\runtimes\win-x64\native\libespeak-ng.dll"
          DestinationFolder="$(OutputPath)" />
    <ItemGroup>
      <EspeakDataFiles Include="$(MSBuildProjectDirectory)\runtimes\win-x64\native\espeak-ng-data\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EspeakDataFiles)"
          DestinationFolder="$(OutputPath)\espeak-ng-data\%(RecursiveDir)" />
    <ItemGroup>
      <ModelFiles Include="$(MSBuildProjectDirectory)\Models\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModelFiles)"
          DestinationFolder="$(OutputPath)\Models\%(RecursiveDir)" />
  </Target>

</Project>
